        ],
        "rtl": [
          {"file":"assets/rtl/spw_datalink_v2.sv","symbol":"w_send_nchar","start":873,"end":883,"role":"credit gate"},
          {"file":"assets/rtl/spw_datalink_v2.sv","symbol":"ow_nchar_ready","start":955,"end":966,"role":"interface observable"}
        ],
        "test": [{"file":"tests/rtl/tb_credit_mvp.sv","symbol":"REQ-FC-F","start":142,"end":152,"role":"executable check"}]
      },
      "waveform": {"signals":["nchar_valid","nchar_ready","send_nchar","tx_credit"],"event_signal":"nchar_valid","window_start":455000,"window_end":485000,"annotation":"Pending N-Char blocked at zero credit"}
    },
    {
      "id": "REQ-FC-HJ",
      "title": "Credit bound and overflow error",
      "spec": {"clause":"5.5.4.h / 5.5.4.j / 5.5.5.a.2","pdf_pages":[75],"printed_pages":[75],"excerpt":"The transmit credit count shall have a maximum value of 56. An FCT that causes it to exceed the maximum shall raise a credit error.","highlights":[{"x":28.0,"y":12.1,"width":61.0,"height":4.5,"label":"§5.5.4.h"},{"x":28.0,"y":18.2,"width":61.0,"height":4.5,"label":"§5.5.4.j"},{"x":32.0,"y":56.0,"width":55.0,"height":4.5,"label":"§5.5.5.a.2"}]},
      "behavior": {"trigger":"An FCT is received when tx_credit is 56.","precondition":"Link state is Connecting or Run.","expected":"credit_error = 1 and tx_credit remains 56.","verdict":"PASS when overflow is detected combinationally and the state does not exceed MAX_CREDIT."},
      "observables": ["got_fct", "tx_credit", "credit_error", "tx_credit_overflow"],
      "result_ids": ["REQ-FC-HJ-COMB", "REQ-FC-HJ-STATE"],
      "trace": {
        "golden": [
          {"file":"assets/golden/spw_ref_model.py","symbol":"SpWLink.MAX_CREDIT","start":459,"end":460,"role":"Golden bound"},
          {"file":"assets/golden/spw_ref_model.py","symbol":"SpWLink.on_char","start":619,"end":630,"role":"overflow oracle"},
          {"file":"assets/golden/spw_ref_model_test_v5.py","symbol":"scenario_9_credit_error_injection","start":571,"end":607,"role":"Golden scenario"}
        ],
        "rtl": [
          {"file":"assets/rtl/spw_datalink_v2.sv","symbol":"w_tx_credit_err","start":642,"end":655,"role":"overflow detection"},
