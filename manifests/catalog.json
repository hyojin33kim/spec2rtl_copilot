      },
      "waveform": {"signals":["got_fct","tx_credit","credit_error","tx_credit_overflow"],"event_signal":"credit_error","window_start":525000,"window_end":555000,"annotation":"Overflow attempt: error asserted, tx_credit remains 56"}
